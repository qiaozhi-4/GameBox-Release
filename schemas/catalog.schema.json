{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qiaozhi-4/GameBox-Release/blob/main/schemas/catalog.schema.json",
  "title": "GameBox release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "repository",
    "endpoints",
    "app",
    "native",
    "content",
    "supportedAbis"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "gamebox-catalog"
    },
    "status": {
      "type": "string",
      "enum": [
        "bootstrap",
        "active"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name",
        "visibility",
        "defaultBranch"
      ],
      "properties": {
        "owner": {
          "const": "qiaozhi-4"
        },
        "name": {
          "const": "GameBox-Release"
        },
        "visibility": {
          "const": "public"
        },
        "defaultBranch": {
          "const": "main"
        }
      }
    },
    "endpoints": {
      "$ref": "#/$defs/endpoints"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "latestUrl"
      ],
      "properties": {
        "componentId": {
          "const": "gamebox-app"
        },
        "latestUrl": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/app/latest\\.json$"
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "gamesIndexUrl"
      ],
      "properties": {
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "soId",
            "latestUrl"
          ],
          "properties": {
            "soId": {
              "const": "core"
            },
            "latestUrl": {
              "$ref": "#/$defs/rawUrl",
              "pattern": "/so/core/latest\\.json$"
            }
          }
        },
        "gamesIndexUrl": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/so/games/index\\.json$"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homeUrl",
        "appBaseUrl"
      ],
      "properties": {
        "homeUrl": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/content/home\\.md$"
        },
        "appBaseUrl": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/content/apps/$"
        }
      }
    },
    "supportedAbis": {
      "$ref": "#/$defs/abis"
    }
  },
  "$defs": {
    "rawUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://raw\\.githubusercontent\\.com/qiaozhi-4/GameBox-Release/main/"
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appLatest",
        "coreLatest",
        "gamesIndex",
        "home",
        "appContentBase"
      ],
      "properties": {
        "appLatest": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/app/latest\\.json$"
        },
        "coreLatest": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/so/core/latest\\.json$"
        },
        "gamesIndex": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/so/games/index\\.json$"
        },
        "home": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/content/home\\.md$"
        },
        "appContentBase": {
          "$ref": "#/$defs/rawUrl",
          "pattern": "/content/apps/$"
        }
      }
    },
    "abis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "arm64-v8a",
          "armeabi-v7a",
          "x86",
          "x86_64"
        ]
      }
    }
  }
}
