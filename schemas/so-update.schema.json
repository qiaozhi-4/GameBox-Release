{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qiaozhi-4/GameBox-Release/blob/main/schemas/so-update.schema.json",
  "title": "GameBox native artifact update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "soId",
    "displayName",
    "versionCode",
    "versionName",
    "releaseTag",
    "publishedAt",
    "packaging",
    "requiresCore",
    "minAppVersionCode",
    "supportedAbis",
    "dependencies",
    "artifacts",
    "changelogUrl"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "so-update"
    },
    "soId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1
    },
    "versionName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packaging": {
      "type": "string",
      "enum": [
        "separate-core",
        "self-contained-game"
      ]
    },
    "requiresCore": {
      "type": "boolean"
    },
    "minAppVersionCode": {
      "type": "integer",
      "minimum": 1
    },
    "supportedAbis": {
      "$ref": "#/$defs/abis"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "changelogUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://raw\\.githubusercontent\\.com/qiaozhi-4/GameBox-Release/main/so/(?:core/changelog|games/[a-z0-9]+(?:-[a-z0-9]+)*/changelog)/v[^/]+\\.md$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "soId": {
            "const": "core"
          }
        }
      },
      "then": {
        "properties": {
          "packaging": {
            "const": "separate-core"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packaging": {
            "const": "self-contained-game"
          }
        }
      },
      "then": {
        "properties": {
          "requiresCore": {
            "const": false
          },
          "dependencies": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "abi": {
      "type": "string",
      "enum": [
        "arm64-v8a",
        "armeabi-v7a",
        "x86",
        "x86_64"
      ]
    },
    "abis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/abi"
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soId",
        "minVersionCode"
      ],
      "properties": {
        "soId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "minVersionCode": {
          "type": "integer",
          "minimum": 1
        },
        "maxVersionCode": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi",
        "fileName",
        "downloadUrl",
        "sha256",
        "size"
      ],
      "properties": {
        "abi": {
          "$ref": "#/$defs/abi"
        },
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.so$"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/qiaozhi-4/GameBox-Release/releases/download/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
