{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qiaozhi-4/GameBox-Release/blob/main/schemas/app-update.schema.json",
  "title": "GameBox app update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "componentId",
    "versionCode",
    "versionName",
    "releaseTag",
    "publishedAt",
    "minVersionCode",
    "forceUpdate",
    "artifact",
    "changelogUrl"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "app-update"
    },
    "componentId": {
      "const": "gamebox-app"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1
    },
    "versionName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^app-v[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minVersionCode": {
      "type": "integer",
      "minimum": 1
    },
    "forceUpdate": {
      "type": "boolean"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "changelogUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://raw\\.githubusercontent\\.com/qiaozhi-4/GameBox-Release/main/app/changelog/v[^/]+\\.md$"
    }
  },
  "$defs": {
    "abi": {
      "type": "string",
      "enum": [
        "arm64-v8a",
        "armeabi-v7a",
        "x86",
        "x86_64"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "abi",
        "downloadUrl",
        "sha256",
        "size"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.apk$"
        },
        "abi": {
          "$ref": "#/$defs/abi"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/qiaozhi-4/GameBox-Release/releases/download/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
